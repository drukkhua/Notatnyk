{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Дозволи для локального сховища нотаток у AppData",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux", "android", "iOS"],
  "permissions": [
    "core:default",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/Volumes/**" }
      ]
    }
  ]
}
