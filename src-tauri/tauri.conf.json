{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notatnyk",
  "version": "1.0.0",
  "identifier": "com.local.notatnyk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Notatnyk",
        "width": 980,
        "height": 660,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../notes-testing/book-club.md": "demo/",
      "../notes-testing/elektromontazh.md": "demo/",
      "../notes-testing/gazon-ozelenenie.md": "demo/",
      "../notes-testing/gruzoperevozki.md": "demo/",
      "../notes-testing/klining.md": "demo/",
      "../notes-testing/kofejnya-launch.md": "demo/",
      "../notes-testing/konditsionery.md": "demo/",
      "../notes-testing/kuhnya-na-zakaz.md": "demo/",
      "../notes-testing/natyazhnye-potolki.md": "demo/",
      "../notes-testing/remont-kvartiry.md": "demo/"
    },
    "android": {
      "minSdkVersion": 36
    }
  }
}
