{
  "_meta": {
    "syntaxVersion": "1.2.1",
    "note": "Contract-fixtures для движка ТЗ (render()/inline() в src/parser.js и src/lib/specEngine.ts). Копия этого файла должна быть идентична в notatnyk-tauri/test/spec-fixtures.json и BitrixUI/frontend/src/lib/__tests__/spec-fixtures.json — при изменении грамматики обновляй оба файла и SPEC_SYNTAX_VERSION в обоих движках (см. docs/print-spec-parser-render-audit.md, раздел 5)."
  },
  "cases": [
    {
      "name": "flat-numbering-labels-verbatim",
      "source": "1. Общие требования\n1.1 Формат\n1.2. Материал\n1.2.1 Ламинация",
      "mode": "edit",
      "expect": {
        "htmlIncludes": [
          "<div data-line=\"0\" class=\"r-num\">1. Общие требования</div>",
          "<div data-line=\"1\" class=\"r-num\">1.1 Формат</div>",
          "<div data-line=\"2\" class=\"r-num\">1.2. Материал</div>",
          "<div data-line=\"3\" class=\"r-num\">1.2.1 Ламинация</div>"
        ]
      }
    },
    {
      "name": "money-decimal-comma-in-total-line",
      "source": "Итого: 10,50 грн",
      "mode": "edit",
      "expect": {
        "sections": [{ "declared": 10.5, "sum": 0 }],
        "diagnosticsInclude": [{ "code": "local_total_mismatch", "line": 0 }]
      }
    },
    {
      "name": "money-thousands-and-decimal-comma",
      "source": "Итого: 1 250,75 грн",
      "mode": "edit",
      "expect": { "sections": [{ "declared": 1250.75, "sum": 0 }] }
    },
    {
      "name": "total-russian-and-ukrainian-aliases-in-one-document",
      "source": "= 100 грн\nИтого: 100 грн\n= 200 грн\nРазом: 200 грн",
      "mode": "edit",
      "expect": {
        "total": 300,
        "declared": 300,
        "positions": 2,
        "sections": [{ "declared": 100, "sum": 100 }, { "declared": 200, "sum": 200 }],
        "htmlIncludes": ["<b>Итого:</b>", "<b>Разом:</b>"]
      }
    },
    {
      "name": "multiple-products-sum-not-alternatives",
      "source": "[ ] Продукт А:\n= 1000 грн\nИтого: 1000 грн\n[ ] Продукт Б:\n= 500 грн\nИтого: 500 грн",
      "mode": "edit",
      "expect": {
        "total": 1500,
        "declared": 1500,
        "checksTotal": 2,
        "checksDone": 0,
        "positions": 2,
        "sections": [{ "declared": 1000, "sum": 1000 }, { "declared": 500, "sum": 500 }]
      }
    },
    {
      "name": "hidden-block-visible-in-edit",
      "source": "/* внутренняя формула\nсекретный текст\n*/\n= 500 грн",
      "mode": "edit",
      "expect": { "total": 500, "htmlIncludes": ["class=\"r-hidden\"", "секретный текст"] }
    },
    {
      "name": "hidden-block-absent-in-export",
      "source": "/* внутренняя формула\nсекретный текст\n*/\n= 500 грн",
      "mode": "export",
      "expect": { "total": 500, "htmlExcludes": ["r-hidden", "секретный текст"] }
    },
    {
      "name": "dangerous-url-quote-and-script-tag-neutralized",
      "source": "Смотри тут: https://evil.example/\"onmouseover=\"alert(1) и <script>alert(2)</script> тест",
      "mode": "edit",
      "expect": {
        "htmlIncludes": [
          "<a href=\"https://evil.example/\" target=\"_blank\" rel=\"noopener\">https://evil.example/</a>",
          "&lt;script&gt;alert(2)&lt;/script&gt;"
        ],
        "htmlExcludes": ["example/\"onmouseover=\"", "<script>alert(2)</script>"]
      }
    },
    {
      "name": "checkbox-data-line-preserved",
      "source": "[ ] Task one\n[x] Task two",
      "mode": "edit",
      "expect": {
        "checksTotal": 2,
        "checksDone": 1,
        "htmlIncludes": [
          "<div data-line=\"0\" class=\"r-check\" data-check=\"0\">",
          "<div data-line=\"1\" class=\"r-check done\" data-check=\"1\">"
        ]
      }
    },
    {
      "name": "table-escaped-pipe-and-semantic-header",
      "source": "| Назва | Ціна\\|Знижка |\n| --- | --- |\n| Візитки | 100\\|10% |",
      "mode": "edit",
      "expect": {
        "htmlIncludes": [
          "<tr class=\"r-tr-head\"><th>Назва</th><th>Ціна|Знижка</th></tr>",
          "<tr><td>Візитки</td><td>100|10%</td></tr>"
        ]
      }
    },
    {
      "name": "unclosed-hidden-block-warns-in-edit",
      "source": "/* not closed",
      "mode": "edit",
      "expect": {
        "htmlIncludes": ["Блок /* открыт в строке 1 и не закрыт — всё ниже скрыто"],
        "diagnosticsInclude": [{ "code": "unclosed_hidden_block", "line": 0 }]
      }
    },
    {
      "name": "unclosed-hidden-block-silent-in-export",
      "source": "/* not closed",
      "mode": "export",
      "expect": {
        "htmlExcludes": ["не закрыт"],
        "diagnosticsInclude": [{ "code": "unclosed_hidden_block", "line": 0 }]
      }
    },
    {
      "name": "unknown-variable-left-untouched",
      "source": "[nope] грн",
      "mode": "edit",
      "expect": { "total": 0, "positions": 0, "htmlIncludes": ["[nope] грн"] }
    },
    {
      "name": "diagnostics-template-placeholder-qty-and-price",
      "source": "- Тираж: — шт\nЦена = 0 грн",
      "mode": "edit",
      "expect": {
        "diagnosticsInclude": [
          { "code": "template_placeholder", "line": 0 },
          { "code": "template_placeholder", "line": 1 }
        ]
      }
    },
    {
      "name": "diagnostics-empty-product-name",
      "source": "[ ] :",
      "mode": "edit",
      "expect": { "diagnosticsInclude": [{ "code": "template_placeholder", "line": 0 }] }
    },
    {
      "name": "quantity-same-unit-addition",
      "source": "50 шт + 50 шт =",
      "mode": "edit",
      "expect": {
        "total": 0,
        "htmlIncludes": ["<span class=\"calc-formula\">50 шт + 50 шт</span>", "<span class=\"calc-res\">100 шт</span>"]
      }
    },
    {
      "name": "quantity-currency-formula-sums-once",
      "source": "3720 грн - 10% =",
      "mode": "edit",
      "expect": { "total": 3348, "positions": 0, "htmlIncludes": ["<span class=\"price-sum\">3 348,00 грн</span>"] }
    },
    {
      "name": "quantity-terminal-drives-total-line",
      "source": "= 3348 грн\nИтого: 3720 грн - 10% =",
      "mode": "edit",
      "expect": {
        "declared": 3348,
        "sections": [{ "declared": 3348, "sum": 3348 }],
        "htmlIncludes": ["<span class=\"r-total-ok\">✓</span>"]
      }
    },
    {
      "name": "quantity-area-unit-not-mistaken-for-percent",
      "source": "50 м2 + 10% =",
      "mode": "edit",
      "expect": { "htmlIncludes": ["55 м2"], "htmlExcludes": ["2,2", "<span class=\"calc-res\">2,2</span>"] }
    },
    {
      "name": "quantity-arbitrary-unit-fractional-result",
      "source": "5 автомобилей - 10% =",
      "mode": "edit",
      "expect": { "htmlIncludes": ["<span class=\"calc-res\">4,5 автомобилей</span>"] }
    },
    {
      "name": "quantity-unit-with-plus-modifier",
      "source": "100 A3+ - 10% =",
      "mode": "edit",
      "expect": { "htmlIncludes": ["<span class=\"calc-res\">90 A3+</span>"] }
    },
    {
      "name": "quantity-per-unit-currency-excluded-from-sum",
      "source": "10 грн/шт - 10% =",
      "mode": "edit",
      "expect": { "total": 0, "htmlIncludes": ["<span class=\"calc-res\">9 грн/шт</span>"] }
    },
    {
      "name": "quantity-unit-mismatch-preserves-text",
      "source": "50 шт + 2 кг =",
      "mode": "edit",
      "expect": {
        "total": 0,
        "htmlIncludes": ["50 шт + 2 кг ="],
        "htmlExcludes": ["calc-res"],
        "diagnosticsInclude": [{ "code": "quantity_unit_mismatch", "line": 0 }]
      }
    },
    {
      "name": "quantity-inside-backticks-not-evaluated",
      "source": "`50 шт + 50 шт =` пример синтаксиса",
      "mode": "edit",
      "expect": {
        "total": 0,
        "htmlIncludes": ["<code>50 шт + 50 шт =</code>"],
        "htmlExcludes": ["calc-res", "calc-formula"],
        "diagnosticsExclude": [{ "code": "quantity_syntax_error" }]
      }
    },
    {
      "name": "quantity-unfinished-line-no-diagnostic",
      "source": "50 шт + 50 шт",
      "mode": "edit",
      "expect": { "diagnosticsCount": 0 }
    },
    {
      "name": "quantity-unknown-numeric-variable",
      "source": "[остаток] шт + 2 шт =",
      "mode": "edit",
      "expect": {
        "htmlIncludes": ["[остаток] шт + 2 шт ="],
        "diagnosticsInclude": [{ "code": "quantity_unknown_variable", "line": 0 }]
      }
    },
    {
      "name": "quantity-client-mode-hides-formula",
      "source": "3720 грн - 10% =",
      "mode": "export",
      "expect": {
        "total": 3348,
        "htmlIncludes": ["<span class=\"price-sum\">3 348,00 грн</span>"],
        "htmlExcludes": ["calc-formula", "3720"]
      }
    },
    {
      "name": "quantity-old-scalar-format-with-trailing-currency-unchanged",
      "source": "3720 - 10% = грн",
      "mode": "edit",
      "expect": { "total": 3348, "htmlIncludes": ["<span class=\"price-sum\">3 348 грн</span>"] }
    },
    {
      "name": "quantity-html-in-unit-is-escaped",
      "source": "5 <b>шт + 2 <b>шт =",
      "mode": "edit",
      "expect": {
        "htmlIncludes": ["<span class=\"calc-res\">7 &lt;b&gt;шт</span>"],
        "htmlExcludes": ["<b>шт"]
      }
    },
    {
      "name": "product-parameter-key-value",
      "source": "- Тираж: 500 шт",
      "mode": "edit",
      "expect": {
        "total": 0,
        "htmlIncludes": [
          "<div data-line=\"0\" class=\"r-li r-param\">",
          "<span class=\"r-param-label\">Тираж</span>",
          "<span class=\"r-param-value\">500 шт</span>"
        ]
      }
    },
    {
      "name": "product-parameter-strong-both-ends",
      "source": "- **Матеріал: Крейдований 350**",
      "mode": "edit",
      "expect": {
        "htmlIncludes": [
          "class=\"r-li r-param strong\"",
          "<span class=\"r-param-label\">Матеріал</span>",
          "<span class=\"r-param-value\">Крейдований 350</span>"
        ]
      }
    },
    {
      "name": "product-parameter-plain-list-item-stays-li",
      "source": "- Звичайний пункт списку",
      "mode": "edit",
      "expect": {
        "htmlIncludes": ["<div data-line=\"0\" class=\"r-li\">Звичайний пункт списку</div>"],
        "htmlExcludes": ["r-param"]
      }
    }
  ]
}
